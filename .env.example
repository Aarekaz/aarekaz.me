# Copy to .env (git-ignored). Used ONLY by the build-time bake step
# (scripts/bake-feed.mjs) — never shipped to the browser.

# Full-access token for api.anuragd.me. The bake step uses it to fetch your data
# and distill it into public/creature-feed.json. Keep it secret.
API_TOKEN=""

# Optional override of the API base (defaults to https://api.anuragd.me).
# API_BASE="https://api.anuragd.me"

# Optional: point the *running site* at a live CORS feed instead of the baked
# static file — e.g. a future Cloudflare Worker. Leave unset to read
# /creature-feed.json. This is the one-line upgrade to real-time data.
# VITE_CREATURE_FEED_URL="https://feed.anuragd.me/creature"
